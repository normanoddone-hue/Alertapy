# Copiá este archivo a ".env" y completá los valores reales.
# Nunca subas el archivo ".env" (con secretos reales) a git.

# Puerto del servidor
PORT=3000

# --- Piloto: San Lorenzo, Área Metropolitana de Asunción ---
PILOT_CITY_NAME="San Lorenzo"
PILOT_LAT=-25.3400
PILOT_LON=-57.5088

# --- Umbrales de riesgo (sensación térmica en °C) ---
RISK_THRESHOLD_AMARILLO=34
RISK_THRESHOLD_ROJO=40

# --- WhatsApp Cloud API (Meta for Developers) ---
# 1. Crear una app en https://developers.facebook.com/apps > tipo "Business"
# 2. Agregar el producto "WhatsApp" a la app
# 3. En el panel de WhatsApp > API Setup vas a encontrar:
#    - un número de prueba (Test number) y su "Phone number ID"
#    - un token de acceso temporal (24hs) para probar, o generá uno
#      permanente creando un System User en Meta Business Suite.
# 4. Agregá tu propio celular como "destinatario de prueba" (hasta 5 sin
#    verificar el negocio) para poder recibir mensajes reales ya mismo.
# 5. Creá una plantilla de mensaje (Message Templates) para las alertas
#    proactivas — WhatsApp exige plantillas pre-aprobadas para mensajes
#    que el negocio inicia fuera de una conversación de 24hs. Ejemplo de
#    plantilla de nombre "alerta_calor_asma" (categoría UTILITY):
#
#      "AlertaPy: mañana la sensación térmica en {{1}} llega a {{2}}°C.
#       Si sos asmático o tenés a alguien vulnerable en casa, evitá salir
#       entre las horas de más calor y mantené la medicación a mano."
#
#    La aprobación de Meta suele tardar minutos a un par de días.
#
# Si dejás estas dos variables vacías, el sistema funciona en
# "modo simulado": calcula el riesgo real con datos de clima reales,
# pero en vez de enviar el WhatsApp, lo deja registrado en la base de
# datos y en la consola.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=alerta_calor_asma
WHATSAPP_TEMPLATE_LANG=es

# Clave simple para proteger el endpoint de disparo manual /api/admin/chequear-ahora
ADMIN_KEY=cambiame
